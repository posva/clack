{
  "name": "@posva/clack-root",
  "private": true,
  "type": "module",
  "scripts": {
    "stub": "pnpm -r run build --stub",
    "build": "pnpm --filter \"@posva/clack-*\" run build",
    "start": "pnpm run dev",
    "dev": "pnpm --filter @example/changesets run start",
    "format": "biome check --write",
    "lint": "biome lint --write --unsafe",
    "types": "tsc --noEmit",
    "deps": "pnpm exec knip --production",
    "test": "pnpm --color -r run test",
    "pretest": "pnpm run build",
    "release": "node ./scripts/release.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.2",
    "@changesets/cli": "^2.29.5",
    "@posva/clack-prompts": "workspace:*",
    "@types/node": "^24.1.0",
    "@types/semver": "^7.7.1",
    "conventional-changelog": "^7.2.0",
    "conventional-changelog-angular": "^8.3.1",
    "jsr": "^0.13.4",
    "knip": "^5.62.0",
    "semver": "^7.7.2",
    "typescript": "^5.8.3",
    "unbuild": "^3.6.0"
  },
  "packageManager": "pnpm@9.14.2",
  "volta": {
    "node": "20.18.1"
  }
}
